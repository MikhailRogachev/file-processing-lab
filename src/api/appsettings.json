{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Debug"
    }
  },
  "AllowedHosts": "*",
  "DatabaseConfig": {
    "Host": "localhost",
    "Port": 5432,
    "Database": "fileprocessingDb",
    "Username": "postgres",
    "Password": "postgres"
  },
  "RabbitMQConfig": {
    "Hostname": "localhost",
    "Port": 5672,
    "Uri": "amqp://guest:guest@localhost:5672",
    "Queue": "fileprocessing",
    "Exchange": "fileprocessing"
  },
  "AwsOptions": {
    "EndPoint": "http://127.0.0.1:4566",
    "AccessKeyId": "test",
    "SecretAccessKey": "test",
    "Region": "us-east-1",
    "ConsumerRequestPeriodSec": 5,
    "BucketName": "file-processing-bucket",
    "SqsQueueName": "s3-file-events-queue"
  },
  "OutboxMessageOptions": {
    "ScanIntervalMs": 100,
    "ExceptionsAllowedBeforeBreak": 3,
    "DurationOfBreakSec": 120
  }
}
